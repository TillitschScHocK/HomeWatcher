# ─────────────────────────────────────────────
# Network / VPN
# ─────────────────────────────────────────────

# Local LAN subnet to keep accessible while VPN is active (split-tunneling).
# Change this if your LAN uses a different subnet (e.g. 10.0.0.0/8).
LAN_SUBNET=192.168.0.0/16

# VPN Status Badge — used by GET /api/vpn-status in the backend.
# Set exactly one of the following to enable pass/fail checking in the UI.
# If none is set, the badge shows the current exit IP without a VPN assertion.

# Option A (recommended): set your home/router public IP.
# The badge turns green when the exit IP differs from this value (VPN is on),
# and red when they match (VPN is off / traffic exits via your real IP).
#EXPECTED_HOME_IP=1.2.3.4

# Option B: set the exact public IP that the VPN exit node should present.
#EXPECTED_VPN_IP=158.173.158.100

# Option C: match the ISP/org string reported by the VPN provider (case-insensitive substring).
#EXPECTED_VPN_ORG=cyberghost

# ─────────────────────────────────────────────
# UI / Frontend
# ─────────────────────────────────────────────

# Port on which the web UI is accessible on the host machine.
UI_PORT=1966

# Stream buffer delay in seconds (direct / proxy mode).
VITE_STREAM_DELAY=18

# Additional proxy buffer delay in seconds.
VITE_STREAM_PROXY_DELAY=30

# ─────────────────────────────────────────────
# Watchtower
# ─────────────────────────────────────────────

# Remove old Docker images after updating containers (true/false).
WATCHTOWER_CLEANUP=true

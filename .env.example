# ─────────────────────────────────────────────
# Network / VPN
# ─────────────────────────────────────────────

# Local LAN subnet to keep accessible while VPN is active (split-tunneling).
# Change this if your LAN uses a different subnet (e.g. 10.0.0.0/8).
LAN_SUBNET=192.168.0.0/16

# ─────────────────────────────────────────────
# UI / Frontend
# ─────────────────────────────────────────────

# Port on which the web UI is accessible on the host machine.
UI_PORT=1966

# Stream buffer delay in seconds (direct / proxy mode).
VITE_STREAM_DELAY=18

# Additional proxy buffer delay in seconds.
VITE_STREAM_PROXY_DELAY=30

# ─────────────────────────────────────────────
# Watchtower
# ─────────────────────────────────────────────

# Remove old Docker images after updating containers (true/false).
WATCHTOWER_CLEANUP=true
